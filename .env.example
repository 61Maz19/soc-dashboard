# Copy this file to .env and adjust the values. Never commit .env
TZ=Asia/Baghdad
DOCKER_API=http://socket-proxy:2375
# Comma-separated URLs to health-check (leave empty for none)
CHECK_URLS=
# Your own devices' SSH key fingerprints: fingerprint=name, comma-separated
# Find a fingerprint with: ssh-keygen -lf ~/.ssh/id_ed25519.pub
KNOWN_KEYS=
# Auth log path inside the container (default: /var/log/auth.log)
# AUTH_LOG=/var/log/auth.log
